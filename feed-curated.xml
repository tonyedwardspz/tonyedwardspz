---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name }}</title>
    <description>{{ site.description }}</description>
    <link>{{ site.url }}</link>
    <atom:link href="{{ site.url }}/feed-curated.xml" rel="self" type="application/rss+xml" />
    {% assign curated_posts = site.posts | where_exp: "post", "post.omit != true" %}
    {% for post in curated_posts limit:20 %}
      <item>
        <title>{{ post.title }}</title>
        <description>{{ post.content | xml_escape | replace: 'src=&quot;/ass', 'src=&quot;https://tonyedwardspz.co.uk/ass' | replace: 'href=&quot;/', 'href=&quot;https://tonyedwardspz.co.uk/' }}</description>
        <pubDate>{{ post.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
        <link>{{ site.url }}{{ post.url }}</link>
        <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
